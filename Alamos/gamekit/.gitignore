
# Printed books. Generated by tools/make-book.mjs — one command, ten megabytes,
# and stale the moment any content changes. Regenerate rather than commit:
#   node tools/make-book.mjs all
books/print/

# Copy-edit sheets. Generated by tools/export-copy.mjs for a round of editing
# elsewhere, and stale the moment the book changes. Regenerate rather than
# commit, and keep the manifest only as long as the sheet it belongs to:
#   node tools/export-copy.mjs <theme>
books/copy/

# Contact sheets. Generated by engine/dev/shots.mjs — fifty PNGs of a game's
# rooms, and stale the moment the fit-out changes. Regenerate rather than
# commit:
#   npm run shots <theme>
shots/

# Built games and the landing page that indexes them. `npm run gallery` writes
# dist/<theme>/ for every game plus dist/index.html, and the page is only honest
# about what it has just built. Regenerate rather than commit:
#   npm run gallery
# Note it reads its snapshots out of shots/, which is ignored above — so a fresh
# clone wants `npm run shots <theme>` first, or the cards come up with a
# placeholder where the picture should be.
dist/

# The format gallery's data. Generated by engine/dev/lessonGallery.mjs — one
# authored stop of each of the 35 formats, harvested out of every registered
# game, and stale the moment any of their content changes. Regenerate rather
# than commit:
#   npm run lessons        →  then /engine/dev/lessons.html under npm run dev
engine/dev/lessons.json

# Reader-probe prompts and answers. Generated by engine/dev/readerProbe.mjs —
# one harvest of every answerable stop, plus whatever a run of readers wrote
# back, and stale the moment a card is edited. The answer key is written outside
# this tree entirely (GAMEKIT_PROBE_KEY), because a key sitting next to the
# prompts is a key one `ls` away from the reader. Regenerate rather than commit:
#   node engine/dev/readerProbe.mjs --harvest
reader-probe/
