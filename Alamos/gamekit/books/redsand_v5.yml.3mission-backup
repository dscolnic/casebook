    stage:
      wall:
      - text: 'CARBON ACCOUNTED FOR: 99.8%'
        tone: warn
      - text: 'METHANE TARGET: NOT MET'
        tone: alarm
    panel: 'CARBON ACCOUNTED FOR: 99.8% / METHANE TARGET: NOT MET'
