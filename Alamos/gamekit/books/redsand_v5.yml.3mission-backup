    stage:
      wall:
      - text: 'TOTAL PRESSURE: NORMAL'
        tone: ok
      - text: 'H2 PARTIAL PRESSURE: LOW'
        tone: alarm
      - text: 'N2 DETECTED AFTER PURGE TIE-IN'
        tone: alarm
    panel: 'TOTAL PRESSURE: NORMAL / H2 PARTIAL PRESSURE: LOW / N2 DETECTED AFTER PURGE TIE-IN'
