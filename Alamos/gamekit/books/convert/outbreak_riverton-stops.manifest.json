 "equations": [
  {
   "e": "Rₑ = R₀ × S",
   "about": "effective reproduction number against a susceptible fraction",
   "symbols": [
    [
     "Rₑ",
     "effective reproduction number, cases caused per case now"
    ],
    [
     "R₀",
     "basic reproduction number, in a wholly susceptible population"
    ],
    [
     "S",
     "the fraction still susceptible"
    ]
   ]
  },
  {
   "e": "N(t) = N₀ · 2^(t/T_d)",
   "about": "exponential growth from a doubling time",
   "symbols": [
    [
     "N(t)",
     "how many cases at time t"
    ],
    [
     "N₀",
     "cases at the start"
    ],
    [
     "t",
     "elapsed time"
    ],
    [
     "T_d",
     "doubling time, in the same units as t"
    ]
   ]
  },
  {
   "e": "sensitivity = TP / (TP+FN)",
   "about": "and specificity = TN / (TN+FP) — what a test misses",
   "symbols": [
    [
     "TP",
     "true positives, sick and testing positive"
    ],
    [
     "FN",
     "false negatives, sick and testing negative"
    ],
    [
     "TN",
     "true negatives"
    ],
    [
     "FP",
     "false positives"
    ]
   ]
  },
  {
   "e": "PPV = (prev·sens) / (prev·sens + (1−prev)(1−spec))",
   "about": "why a good test fails at low prevalence",
   "symbols": [
    [
     "PPV",
     "positive predictive value, the chance a positive is real"
    ],
    [
     "prev",
     "prevalence, how common the disease is"
    ],
    [
     "sens",
     "sensitivity"
    ],
    [
     "spec",
     "specificity"
    ]
   ]
  },
  {
   "e": "risk = events / people at risk",
   "about": "and NNT = 1 / (control risk − treated risk)",
   "symbols": [
    [
     "events",
     "how many people had the outcome"
    ],
    [
     "people at risk",
     "how many could have"
    ],
    [
     "NNT",
     "number needed to treat"
    ],
    [
     "control risk",
     "risk without the treatment"
    ],
    [
     "treated risk",
     "risk with it"
    ]
   ]
  },
  {
   "e": "CFR = deaths / cases",
   "about": "case fatality, and what its denominator hides",
   "symbols": [
    [
     "CFR",
     "case fatality ratio"
    ],
    [
     "deaths",
     "deaths among known cases"
    ],
    [
     "cases",
     "cases that were actually diagnosed"
    ]
   ]
  },
  {
   "e": "pH = pKa + log([A⁻]/[HA])",
   "about": "Henderson–Hasselbalch — buffering in a body",
   "symbols": [
    [
     "pH",
     "acidity of the blood"
    ],
    [
     "pKa",
     "the acid constant for that buffer pair, 6.1 for bicarbonate"
    ],
    [
     "[A⁻]",
     "concentration of the base form, bicarbonate"
    ],
    [
     "[HA]",
     "concentration of the acid form, dissolved carbon dioxide"
    ]
   ]
  }
 ],
